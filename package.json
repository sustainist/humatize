    "@types/node": "^26.2.0",
    "firebase": "^12.17.1",
    "mdsvex": "^0.12.8",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.5",
    "typescript": "^6.0.3",
    "vite": "^8.2.1"
  },
  "allowScripts": {
    "protobufjs@7.6.5": true,
    "@firebase/util@1.15.2": true
  }
